<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Flowstead.Engine.Api/Flowstead.Engine.Api.csproj" />
    <ProjectReference Include="../../src/Flowstead.Engine.Contracts/Flowstead.Engine.Contracts.csproj" />
    <!-- Built so the tests can start real worker processes; not referenced as an assembly. -->
    <ProjectReference Include="../../src/Flowstead.Engine.Worker/Flowstead.Engine.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>WorkerPath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../src/Flowstead.Engine.Worker/bin/$(Configuration)/net10.0/linux-x64/Flowstead.Engine.Worker.dll</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BenchmarksDir</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../../benchmarks</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
