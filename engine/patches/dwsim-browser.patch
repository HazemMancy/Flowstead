index 01bbe8c..2ddc0b0 100644
--- a/engine/DWSIM.SharedClasses/TaskHelper/TaskHelper.vb
+++ b/engine/DWSIM.SharedClasses/TaskHelper/TaskHelper.vb
@@ -2,14 +2,27 @@
 
     Public Shared Function Run(action As Action) As Task
 
+        If OperatingSystem.IsBrowser() Then Return RunInline(action)
         Return Task.Run(action)
 
     End Function
 
     Public Shared Function Run(action As Action, ct As Threading.CancellationToken) As Task
 
+        If OperatingSystem.IsBrowser() Then Return RunInline(action)
         Return Task.Run(action, ct)
 
     End Function
 
+    ' WebAssembly in the browser has no thread pool, so callers that wait on the task would throw.
+    ' Run the work on the calling thread and hand back a finished task.
+    Private Shared Function RunInline(action As Action) As Task
+        Try
+            action()
+            Return Task.CompletedTask
+        Catch ex As Exception
+            Return Task.FromException(ex)
+        End Try
+    End Function
+
 End Class
