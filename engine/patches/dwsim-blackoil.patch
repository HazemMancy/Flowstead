+        ' ---- Flowstead patch (D101): one consistent black-oil balance ----
+        ' Per m3 of stock-tank oil: gas GOR Sm3 at 1.225 SGG kg/Sm3 (air at 15 C), oil 999 SGO kg, water 999 WOR kg.
+        ' Standing's Rs is capped at the producing GOR (above the bubble point the oil holds all its gas), Bo above the
+        ' bubble point follows Vasquez-Beggs, and the phase split and the liquid's molecular weight come from the same
+        ' masses and moles, so phase flows add up to the stream's.
+
+        Public Const M3PerM3ToScfPerStb As Double = 5.6146
+        Public Const AirStdDensity As Double = 1.225
+        Public Const WaterStdDensity As Double = 999.0
+        Public Const WaterMolecularWeight As Double = 18.015
+
+        ''' <summary>Standing's Rs at (T, P), scf/STB, calibrated by RsMult and capped at the producing GOR.</summary>
+        Public Function CappedRs(T As Double, P As Double, SGO As Double, SGG As Double, GOR As Double, Optional RsMult As Double = 1.0) As Double
+            Dim Tf As Double = (T - 273.15) * 9 / 5 + 32
+            Dim Ppsia As Double = P * 0.000145038
+            Dim API As Double = 141.5 / SGO - 131.5
+            Dim Rs As Double = SGG * (((Ppsia) / 18.2 + 1.4) * 10 ^ (0.0125 * API - 0.00091 * Tf)) ^ 1.2048 * RsMult
+            Return Math.Max(0.0, Math.Min(Rs, GOR * M3PerM3ToScfPerStb))
+        End Function
 
-            Dim Bos As Double
+        ''' <summary>Standing's bubble point of the live oil at T, psia, calibrated by PbMult.</summary>
+        Public Function BubblePointPsia(T As Double, SGO As Double, SGG As Double, GOR As Double, Optional PbMult As Double = 1.0) As Double
+            Dim Tf As Double = (T - 273.15) * 9 / 5 + 32
+            Dim API As Double = 141.5 / SGO - 131.5
+            Return 18.2 * ((GOR * M3PerM3ToScfPerStb / SGG) ^ (1 / 1.2048) * 10 ^ (0.00091 * Tf - 0.0125 * API) - 1.4) * PbMult
+        End Function
 
-            Bos = 0.9759 + 0.00012 * (Rs * (SGG / SGO) ^ 0.5 + 1.25 * Tf) ^ 1.2
+        ''' <summary>Oil formation volume factor: Standing at and below the bubble point, Vasquez-Beggs above it.</summary>
+        Public Function LiveOilFVF(T As Double, P As Double, SGO As Double, SGG As Double, GOR As Double,
+                                   Optional RsMult As Double = 1.0, Optional BoMult As Double = 1.0, Optional PbMult As Double = 1.0) As Double
+            Dim Tf As Double = (T - 273.15) * 9 / 5 + 32
+            Dim Ppsia As Double = P * 0.000145038
+            Dim API As Double = 141.5 / SGO - 131.5
+            Dim Rs As Double = CappedRs(T, P, SGO, SGG, GOR, 1.0)
+            Dim Bo As Double = 0.9759 + 0.00012 * (Rs * (SGG / SGO) ^ 0.5 + 1.25 * Tf) ^ 1.2
+            Dim Pb As Double = BubblePointPsia(T, SGO, SGG, GOR, PbMult)
+            If Ppsia > Pb AndAlso Pb > 0 Then
+                Dim Rsb As Double = GOR * M3PerM3ToScfPerStb
+                Dim A As Double = 0.00001 * (5 * Rsb + 17.2 * Tf - 1180 * SGG + 12.61 * API - 1433)
+                Bo = Bo * (Pb / Ppsia) ^ A
+            End If
+            Return Bo * BoMult
+        End Function
 
