<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. User-installed CAs are trusted so a self-hosted engine on the local network
     can use a private CA (see docs/engine-setup.md). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
